<?xml version="1.0"?>
<!-- -*- mode: XML -*- -->
<launch>
	<arg name="hand_ip" default="192.168.1.40"/>			   
    <arg name="arm_ip" default="192.168.1.18"/>
    <arg name="arm_port" default="8080"/>
    <arg name="arm_timeout_ms" default="5000"/>
    <arg name="arm_speed_percent" default="20"/>
    <arg name="target_pose_file" default="$(find HandTCPCommunication)/target_pose.json"/>
    <arg name="tools_tcp_file" default="$(find HandTCPCommunication)/tools_Tcp.json"/>
    <arg name="hand_eye_calibration_file" default="$(find HandTCPCommunication)/CalibrateMatrix_EyeInHand.txt"/>
    <arg name="motion_config_file" default=""/>
    <arg name="hand_port" default="20008"/>
    <arg name="hand_connect_timeout_ms" default="250"/>
    <arg name="hand_io_timeout_ms" default="100"/>
    <arg name="hand_reconnect_delay_ms" default="1000"/>
    <arg name="handEnable" default="true"/>	 

    <arg name="Hand_Freedom" default="16"/> <!-- -*-6/9/10/16 自由度选择; 100 最小系统遥操作控制；106/109/110/116  最小系统机械手自由度选择;-*- -->	
    <arg name="JointVelocity" default="250"/> <!-- -*-速度 0-255-*- -->	
    <arg name="JointEffort" default="100"/> <!-- -*-力度 0-255-*- -->	
    <arg name="pose_X" default="-0.94"/>
    <arg name="pose_Y" default="-17.782"/>
    <arg name="pose_Z" default="88.632"/>
    <arg name="pose_RX" default="7.595"/>
    <arg name="pose_RY" default="25.827"/>
    <arg name="pose_RZ" default="353.766"/>


	<node pkg="HandTCPCommunication" type="HandCtrl_node" name="arm" required="true" output="screen" respawn="false">
		
        <param name="hand_ip" value="$(arg hand_ip)" />  
        <param name="arm_ip" value="$(arg arm_ip)"/>
        <param name="arm_port" value="$(arg arm_port)"/>
        <param name="arm_timeout_ms" value="$(arg arm_timeout_ms)"/>
        <param name="arm_speed_percent" value="$(arg arm_speed_percent)"/>
        <param name="target_pose_file" value="$(arg target_pose_file)"/>
        <param name="tools_tcp_file" value="$(arg tools_tcp_file)"/>
        <param name="hand_eye_calibration_file" value="$(arg hand_eye_calibration_file)"/>
        <param name="hand_port" value="$(arg hand_port)"/>
        <param name="hand_connect_timeout_ms" value="$(arg hand_connect_timeout_ms)"/>
        <param name="hand_io_timeout_ms" value="$(arg hand_io_timeout_ms)"/>
        <param name="hand_reconnect_delay_ms" value="$(arg hand_reconnect_delay_ms)"/>
        <param name="handEnable" value="$(arg handEnable)" /> 

        <param name="Hand_Freedom" value="$(arg Hand_Freedom)" />
        <param name="JointVelocity" value="$(arg JointVelocity)" />
        <param name="JointEffort" value="$(arg JointEffort)" />
        <param name="pose_X" value="$(arg pose_X)"/>
        <param name="pose_Y" value="$(arg pose_Y)"/>
        <param name="pose_Z" value="$(arg pose_Z)"/>
        <param name="pose_RX" value="$(arg pose_RX)"/>
        <param name="pose_RY" value="$(arg pose_RY)"/>
        <param name="pose_RZ" value="$(arg pose_RZ)"/>
        
	</node>
    <rosparam if="$(eval arg('motion_config_file') != '')" ns="arm" command="load" file="$(arg motion_config_file)"/>
	
</launch>
